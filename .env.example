# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit it.
# Nothing here is read by the extension. The proxy is the only
# process that ever sees a credential.  (verte-plan.md §08)
# ---------------------------------------------------------------

# Serve mock data and skip eBay + Snowflake entirely.
# Set this to 1 and `npm run proxy` works with no credentials at all.
VERTE_MOCK=1

PORT=8787

# eBay Browse API — https://developer.ebay.com  (lane: proxy)
#
# Create an app under "Application Keysets" and use the PRODUCTION keyset.
# Sandbox has almost no real inventory, so searches come back empty and the
# card looks broken when it is actually working.
#
# The marketplace is not configured here: it is derived from the product's
# own currency, so a CAD product is searched on eBay Canada. See
# marketplaceForCurrency() in proxy/ebay.ts.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Snowflake — campus listings + category knowledge base  (lane: snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=VERTE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
