# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit it.
# Nothing here is read by the extension.
#
# Listings need NO credentials at all: they are read from the retailer's own
# page (Amazon's used buybox) and its own frontend API (Best Buy's open-box
# search), same-origin, by the content script.
# ---------------------------------------------------------------

PORT=8787


# =================================================================
# Snowflake — the category knowledge base  (lane: snowflake)
# =================================================================
#
# OPTIONAL. Leave every value below blank and everything still works: the
# proxy serves the built-in table in proxy/snowflake.ts, which covers all 24
# categories. Nothing on the demo path breaks without this. Fill it in to
# move that table into the warehouse, not to make the product function.
#
# ---- HOW TO HAND THESE OVER ------------------------------------
#
#   1. cp .env.example .env
#   2. Fill in the values below, in .env — NOT in this file.
#   3. Say "done" in the session. I'll run the connection check and load
#      data/category-guidance.sql.
#
#   Do NOT paste a password or a private key into the chat. .env is
#   gitignored, it stays on your machine, and I can read it from there.
#   Anything pasted into a conversation is far harder to rotate later.
#
# ---- STEP 1: get an account (~3 minutes) -----------------------
#
#   https://signup.snowflake.com — 30-day trial, $400 of credits, no card.
#   Any cloud/region is fine. Confirm the email, then sign in to Snowsight.
#
# ---- STEP 2: the five values -----------------------------------

# The account identifier, shaped ORGNAME-ACCOUNT_NAME (e.g. KLXZBQP-AB12345).
#
#   In Snowsight: bottom-left account button -> hover your account ->
#   "Copy account identifier".
#
#   Take the identifier, NOT the full URL. If what you copied ends in
#   .snowflakecomputing.com, cut that off. If it has a dot in the middle,
#   that is the older form — a hyphen is what the driver expects.
SNOWFLAKE_ACCOUNT=

# Your login name — the one you sign in to Snowsight with, not your email
# (unless they happen to be the same). Snowsight: bottom-left -> your name.
SNOWFLAKE_USER=

# --- Pick ONE of the two auth methods below. ---

# METHOD A — password. Quickest, and fine for a hackathon.
#
#   ⚠ Snowflake now enforces MFA on password sign-in for human users, so a
#   plain password may be REJECTED even when it is correct. If the connection
#   check fails with an MFA prompt or "password authentication is disabled",
#   that is expected — use Method B instead. It is not a typo on your end.
SNOWFLAKE_PASSWORD=

# METHOD B — key-pair. What Snowflake actually intends for programmatic
# access, and immune to the MFA problem above. Three commands:
#
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/verte.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/verte.p8 -pubout -out ~/.snowflake/verte.pub
#   # then paste the pubkey body (no BEGIN/END lines, no newlines) into:
#   #   ALTER USER <your user> SET RSA_PUBLIC_KEY='<paste>';
#   # run that in a Snowsight worksheet as ACCOUNTADMIN.
#
# Then point this at the PRIVATE key file. The key itself never leaves your
# machine and never enters the repo — only this path does.
SNOWFLAKE_PRIVATE_KEY_PATH=

# --- The rest are defaults. Change only if your account differs. ---

# On a trial this exists already. Snowsight: Admin -> Warehouses.
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Needs rights to CREATE DATABASE. On a trial your user has ACCOUNTADMIN.
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Created by data/category-guidance.sql — do not create these by hand.
SNOWFLAKE_DATABASE=VERTE
SNOWFLAKE_SCHEMA=PUBLIC
