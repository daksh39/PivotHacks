# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit it.
# Nothing here is read by the extension.
#
# Listings need NO credentials at all: they are read from the retailer's own
# page (Amazon's used buybox) and its own frontend API (Best Buy's open-box
# search), same-origin, by the content script.
# ---------------------------------------------------------------

PORT=8787

# Snowflake — the category knowledge base  (lane: snowflake)
# Optional: without it the proxy serves the built-in category table.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=VERTE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
