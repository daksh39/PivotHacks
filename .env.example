# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit it.
# Nothing here is read by the extension. The proxy is the only
# process that ever sees a credential.  (verte-plan.md §08)
# ---------------------------------------------------------------

# Serve mock data and skip eBay + Snowflake entirely.
# Set this to 1 and `npm run proxy` works with no credentials at all.
VERTE_MOCK=1

PORT=8787

# eBay Browse API — https://developer.ebay.com  (lane: proxy)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Snowflake — campus listings + category knowledge base  (lane: snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=VERTE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
