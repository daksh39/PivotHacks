{
  "manifest_version": 3,
  "name": "Verte",
  "version": "4.0.0",
  "description": "Your sustainability assistant. Tell Verte what you're buying, or open a product page, and see lower-carbon alternatives.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.bundle.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8787/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Verte — buy it used instead",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.co.uk/*",
        "https://www.bestbuy.com/*"
      ],
      "js": [
        "contentScript.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
